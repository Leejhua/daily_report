# Docker ignore file
# Ensure config.yaml is not ignored
!config/config.yaml

# Ignore common development files
.git
.gitignore
README.md
*.md
# .env.example

# Ignore test and development files
tests/
scripts/
examples/
docs/

# Ignore temporary files
*.tmp
*.log
*.pid
*.swp
*.swo
*~

# Ignore IDE files
.vscode/
.idea/
*.sublime-*

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore backup files
*.bak
*.backup
data/backups/

# Ignore output files
analysis_output.txt
*.json
!config/*.json
!feishu_github_mapping.json

# Ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Ignore virtual environments
venv/
env/
ENV/
.venv/
# .env/

# Ignore coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/