# GitHub配置
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_ORG=your_organization_name
GITHUB_REPO=  # 组织级别Discussions时可为空
USE_ORG_DISCUSSIONS=true  # true=组织级别, false=仓库级别

# GLM-4.5配置
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 调度配置
SCHEDULE_CRON=0 18 * * *
TIMEZONE=Asia/Shanghai

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/analyzer.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# 分析配置
ENABLE_DEVIATION_ANALYSIS=true
ENABLE_CLARITY_ANALYSIS=true
ENABLE_CONSISTENCY_ANALYSIS=true

# 性能配置
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=30
RETRY_ATTEMPTS=3
RETRY_DELAY=300

# 飞书开放平台API配置
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_ENABLED=false
FEISHU_DEFAULT_CHAT_ID=  # 默认群聊ID
FEISHU_API_TIMEOUT=30
FEISHU_MAX_RETRIES=3
FEISHU_RETRY_DELAY=1.0

# 飞书Webhook配置（可选，与API配置二选一）
FEISHU_WEBHOOK_URL=your_feishu_webhook_url_here
FEISHU_MAPPING_FILE=config/feishu_mapping.json
