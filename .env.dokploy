# GitHub配置 - 必需
GITHUB_TOKEN=your_github_token_here
GITHUB_ORG=your_organization_name
GITHUB_REPO=your_repository_name
USE_ORG_DISCUSSIONS=false

# GLM-4.5配置 - 必需
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-4-plus

# 飞书配置 - 可选
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_WEBHOOK_URL=your_feishu_webhook_url

# 调度配置
SCHEDULE_CRON=0 18 * * *
TIMEZONE=Asia/Shanghai
CONTENT_CHECK_CRON_1=0 12 * * *
CONTENT_CHECK_CRON_2=0 19 * * *
ANALYSIS_CRON_1=0 13 * * *
ANALYSIS_CRON_2=0 20 * * *

# 周报配置
WEEKLY_REPORTS_ENABLED=true
WEEKLY_EXECUTION_HOUR=17
WEEKLY_EXECUTION_DAY=5

# 日志配置
LOG_LEVEL=INFO
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# 分析功能配置
ENABLE_DEVIATION_ANALYSIS=true
ENABLE_CLARITY_ANALYSIS=true
ENABLE_CONSISTENCY_ANALYSIS=true
ENABLE_WEEKLY_REPORTS=true

# 性能配置
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=30
RETRY_ATTEMPTS=3
RETRY_DELAY=300
ANALYSIS_TIMEOUT=1800
WEEKLY_REPORT_TIMEOUT=3600

# 存储配置
STORAGE_TYPE=json
DATA_BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30

# 监控配置 - 可选
GRAFANA_ADMIN_PASSWORD=admin123

# Dokploy特定配置
DOKPLOY_PROJECT_NAME=github-analyzer
DOKPLOY_ENVIRONMENT=production
DOKPLOY_DOMAIN=your-domain.com